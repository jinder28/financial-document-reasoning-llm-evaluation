# Secrets: keep only the empty example configuration.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
credentials*.json

# Python environments and caches.
.venv/
venv/
env/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Scratch outputs are not the retained study evidence.
/outputs/*
!/outputs/.gitkeep

# Packaging, backups, logs and workstation state.
*.zip
*.7z
*.bak
*.bak_*
*.log
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
