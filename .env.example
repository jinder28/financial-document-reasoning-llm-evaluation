# Dissertation apparatus runtime configuration.
OPENAI_API_KEY=
MODEL_PROVIDER=openai
OPENAI_MODEL_ID=gpt-5.5
OPENAI_EMBEDDING_MODEL_ID=text-embedding-3-large
OPENAI_REASONING_EFFORT=medium
OPENAI_MAX_OUTPUT_TOKENS=1500
OPENAI_TEMPERATURE=0

# Paths inside the container. docker-compose mounts ./inputs and ./outputs.
QUEUE_CSV_PATH=/workspace/inputs/queue/api_execution_queue_locked_v1_amendment001.csv
SCORING_KEY_CSV_PATH=/workspace/inputs/scoring/scoring_key_locked_v1_amendment001.csv
CLAIM_MANIFEST_CSV_PATH=/workspace/inputs/claims/claim_case_manifest_v1_locked_amendment001.csv
RUN_MANIFEST_JSON_PATH=/workspace/inputs/manifests/run_manifest_locked_v1_amendment001.json
CLEAN_TEXT_DIRECTORY=/workspace/inputs/clean_text
RAG_CONTEXTS_JSONL_PATH=/workspace/inputs/rag/rag_retrieved_contexts_locked_v1.jsonl
OUTPUT_DIRECTORY=/workspace/outputs

# Experiment controls.
EXPERIMENT_RUN_ID=MAIN_RUN_001_AMENDMENT001_GPT55
COST_WARNING_USD=90
COST_HARD_LIMIT_USD=125
INPUT_COST_USD_PER_MILLION_TOKENS=5
OUTPUT_COST_USD_PER_MILLION_TOKENS=30
MAX_RETRY_ATTEMPTS=1
RAG_TOP_K=8
RAG_CHUNK_WORD_COUNT=750
RAG_CHUNK_OVERLAP_WORD_COUNT=100

# Feature toggles; keep live calls disabled unless intentionally executing smoke/full run.
ENABLE_SEC_FETCH=false
ENABLE_TEXT_CLEANING=false
ENABLE_RAG_CONTEXT_REBUILD=false
ENABLE_PROMPT_PAYLOAD_CAPTURE=true
ENABLE_FULL_PROMPT_TEXT_STORAGE=true
ENABLE_PROMPT_HASHING=true
ENABLE_LIVE_MODEL_CALLS=false
ENABLE_COST_GUARD=true
ENABLE_RETRY_POLICY=true
ENABLE_APPENDIX_E_EXPORT=true
ENABLE_LOCAL_FILE_STORAGE=true
ENABLE_VECTOR_STORE_FAISS=false
